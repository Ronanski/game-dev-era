<Window x:Class="KwartoTV.App.Player.OsdWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Focusable="False" IsHitTestVisible="False"
        Foreground="White" FontFamily="Segoe UI" UseLayoutRounding="True">
  <Grid>
    <!-- channel banner -->
    <Border x:Name="Banner" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="64,56,0,0" Padding="28,18,34,18"
            CornerRadius="20" Background="#E60B0D12" BorderBrush="#FFFF7A45" BorderThickness="0,0,0,4">
      <StackPanel Orientation="Horizontal">
        <TextBlock x:Name="BannerNumber" FontSize="64" FontWeight="Bold" Foreground="#FFFF7A45" Margin="0,0,24,0" VerticalAlignment="Center"/>
        <StackPanel VerticalAlignment="Center">
          <TextBlock x:Name="BannerName" FontSize="34" FontWeight="SemiBold" MaxWidth="760" TextTrimming="CharacterEllipsis"/>
          <TextBlock x:Name="BannerGroup" FontSize="20" Foreground="#FF9AA3B8"/>
          <TextBlock x:Name="BannerNow" FontSize="24" Foreground="#FFFFFFFF" MaxWidth="760" TextTrimming="CharacterEllipsis" Margin="0,8,0,0" Visibility="Collapsed"/>
          <TextBlock x:Name="BannerNext" FontSize="18" Foreground="#FF9AA3B8" MaxWidth="760" TextTrimming="CharacterEllipsis" Visibility="Collapsed"/>
          <TextBlock Text="OK = channel list    ▲▼ = channel    Hold OK = Home" FontSize="15" Foreground="#FF6F788C" Margin="0,6,0,0"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- number being typed -->
    <Border x:Name="DigitBox" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,56,64,0" Padding="30,8" CornerRadius="18" Background="#E60B0D12">
      <TextBlock x:Name="DigitText" FontSize="84" FontWeight="Bold" FontFamily="Consolas" Foreground="#FFFFB36B"/>
    </Border>

    <!-- centre message -->
    <Border x:Name="MessageBox" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="36,20" CornerRadius="18" Background="#E60B0D12">
      <TextBlock x:Name="MessageText" FontSize="30" TextAlignment="Center" MaxWidth="900" TextWrapping="Wrap"/>
    </Border>

    <!-- mini guide -->
    <Border x:Name="Guide" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="760" Margin="0,48,48,48" Padding="20,18" CornerRadius="22" Background="#F00B0D12">
      <DockPanel>
        <Grid DockPanel.Dock="Top" Margin="4,0,4,12">
          <TextBlock Text="◀" FontSize="28" Foreground="#FFFF7A45" HorizontalAlignment="Left" VerticalAlignment="Center"/>
          <StackPanel HorizontalAlignment="Center">
            <TextBlock x:Name="GuideTitle" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="560"/>
            <TextBlock x:Name="GuideSub" FontSize="15" Foreground="#FF9AA3B8" HorizontalAlignment="Center"/>
          </StackPanel>
          <TextBlock Text="▶" FontSize="28" Foreground="#FFFF7A45" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>
        <TextBlock DockPanel.Dock="Bottom" Text="◀▶ category    ▲▼ choose    OK watch    Hold OK close" FontSize="15" Foreground="#FF9AA3B8" Margin="8,12,0,0" TextWrapping="Wrap"/>
        <StackPanel x:Name="GuideRows"/>
      </DockPanel>
    </Border>

    <!-- progress -->
    <Border x:Name="Progress" Visibility="Collapsed" VerticalAlignment="Bottom" Margin="64,0,64,48" Padding="28,16" CornerRadius="20" Background="#E60B0D12">
      <StackPanel>
        <DockPanel>
          <TextBlock x:Name="ProgressTitle" FontSize="26" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
        <Grid Margin="0,10,0,6" Height="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="FillCol" Width="0*"/>
            <ColumnDefinition x:Name="RestCol" Width="1*"/>
          </Grid.ColumnDefinitions>
          <Border Grid.ColumnSpan="2" Background="#33FFFFFF" CornerRadius="4"/>
          <Border Background="#FFFF7A45" CornerRadius="4"/>
        </Grid>
        <TextBlock x:Name="ProgressTime" FontSize="18" Foreground="#FF9AA3B8"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>
