; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Alamat ng Huling Buwan"
config/description="Isang story-driven JRPG: misteryo, pulitika, at mitolohiyang Pilipino."
config/version="0.1.0"
run/main_scene="res://scenes/title.tscn"
config/features=PackedStringArray("4.3", "Mobile")
config/icon="res://icon.svg"
config/quit_on_go_back=false

[autoload]

GameState="*res://scripts/autoload/game_state.gd"
Sprites="*res://scripts/autoload/sprite_factory.gd"
Dialogue="*res://scripts/autoload/dialogue.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[input_devices]

pointing/emulate_mouse_from_touch=true

[rendering]

renderer/rendering_method="mobile"
textures/canvas_textures/default_texture_filter=0
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
